    "max_tokens_per_response": 1024
  },
  "timeouts": {
    "llm_call_seconds": 60,
    "round_timeout_seconds": 180,
    "heartbeat_interval_seconds": 10,
    "heartbeat_timeout_seconds": 30
  },
  "watchdog": {
    "max_restarts_per_process": 3
  }
